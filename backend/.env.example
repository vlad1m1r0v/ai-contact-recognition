# Groq Authentication Key (Required)
GROQ_API_KEY=your_groq_api_key_here

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Vision LLM model identifier (Optional, defaults to meta-llama/llama-4-scout-17b-16e-instruct)
LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# FastAPI service bind configurations
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

# MongoDB Configurations
MONGODB_URL=mongodb://admin:adminpassword@localhost:27017
MONGODB_DATABASE=contact_recognition
